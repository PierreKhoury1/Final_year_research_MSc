+    *graph = nullptr;
+    if(!m_cudaGraphModeEnabled || !m_deviceGraphLaunchEnabled || m_useGreenContext ||
+       m_earlyHarqModeEnabled || m_subSlotProcessingFrontLoadedDmrsEnabled ||
