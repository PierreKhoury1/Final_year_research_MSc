+    if(!puschRxHndl || !graph) return CUPHY_STATUS_INVALID_ARGUMENT;
+    return cuphy::tryCallableAndCatch([&]
+    {
+        return static_cast<PuschRx*>(puschRxHndl)->getReplayGraph(graph);
+    });
