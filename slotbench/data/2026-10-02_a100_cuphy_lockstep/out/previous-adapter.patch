+struct LockstepValidation final
+{
+    cuphy::pusch_rx& pipeline;
+    EvalDataset& reference;
+    DynApiDataset& dataset;
+};
+
+int validateLockstepOutput(void* opaque)
+{
+    auto& validation = *static_cast<LockstepValidation*>(opaque);
+    try
+    {
+        // The executive has finished its stream before invoking this callback. Copies and
+        // reference checks are outside timing, and use the ordinary cuPHY output path.
+        validation.pipeline.run(PUSCH_RUN_FULL_SLOT_COPY);
+        CUDA_CHECK_EXCEPTION(cudaStreamSynchronize(validation.dataset.puschDynPrm.phase1Stream));
+        CUDA_CHECK_EXCEPTION(cudaStreamSynchronize(validation.dataset.puschDynPrm.phase2Stream));
+        const auto& output = validation.dataset.DataOut;
+        if(validation.reference.nTbs == 0 || validation.reference.nCbs == 0 ||
+           output.totNumTbs != validation.reference.nTbs || output.totNumCbs != validation.reference.nCbs ||
+           !output.pTbCrcs || !output.pCbCrcs || !output.pTbPayloads)
+            return 1;
+        uint32_t crcErrors = 0;
+        for(uint32_t i = 0; i < validation.reference.nTbs; ++i)
+            crcErrors += output.pTbCrcs[i] != 0;
+        for(uint32_t i = 0; i < validation.reference.nCbs; ++i)
+            crcErrors += output.pCbCrcs[i] != 0;
+        const uint32_t payloadErrors = validation.reference.computeNumCbErrors(validation.dataset);
+        printf("Lockstep validation: payload/CB errors %u, CRC errors %u\n", payloadErrors, crcErrors);
+        return (payloadErrors == 0 && crcErrors == 0) ? 0 : 1;
+    }
+    catch(const std::exception& error)
+    {
+        fprintf(stderr, "Lockstep validation failed: %s\n", error.what());
+        return 1;
+    }
+}
