     assert all(w["role"] == "fence" for w in fence) and k["204:0,2,0"]["status"] == "PASS"   # reported, not compared
+
+
+def test_sm90_fence_pair_is_one_fence():
+    """sm_90 ptxas (CUDA 12.2 and 12.6, H100, 9 Oct 2026) emits MEMBAR.ALL.CTA directly before the scoped MEMBAR of one
+    PTX fence: the adjacent pair passes as that fence; split by another instruction, or with a scoped MEMBAR of the
+    wrong form, the fence check still fails."""
+    text, exp = handmade()
+
+    def kernel(fn):
+        g = sr.gate(mutate(text, "204:0,0,8", fn), exp["consts"])
+        return next(x for x in g["kernels"] if x["key"] == "204:0,0,8")
+
+    def failed(r):
+        return [c["name"] for c in r["checks"] if not c["ok"]]
+
+    pair = kernel(lambda L: insert(L, find(L, r"MEMBAR\.SC\.GPU"), "MEMBAR.ALL.CTA"))
+    assert pair["status"] == "PASS" and pair["info"]["fence"][:2] == ["MEMBAR.ALL.CTA", "MEMBAR.SC.GPU"], failed(pair)
+    split = kernel(lambda L: insert(L, find(L, r" STG"), "MEMBAR.ALL.CTA"))
+    assert split["status"] == "FAIL" and any(b.startswith("one sc_gpu fence") for b in failed(split)), failed(split)
+    wrong = kernel(lambda L: insert(replace(L, r"MEMBAR\.SC\.GPU", "MEMBAR.SC.SYS"), find(L, r"MEMBAR\.SC\.GPU"), "MEMBAR.ALL.CTA"))
+    assert wrong["status"] == "FAIL" and any(b.startswith("one sc_gpu fence") for b in failed(wrong)), failed(wrong)
